# Gatsby Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gatsby_db
# For local development with SQLite:
# DATABASE_URL=file:./dev.db

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key

# Instagram OAuth (https://developers.facebook.com/apps/)
INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/auth/instagram/callback

# Twilio SMS (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Admin Access
ADMIN_SECRET=your-admin-secret-key-change-this

# Socket.IO
SOCKET_IO_CORS_ORIGIN=http://localhost:3000
